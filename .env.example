# Copy this file to .env and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key (safe for browser use; access is controlled by
# Row Level Security rules in Supabase, not by keeping this secret)
VITE_SUPABASE_ANON_KEY=
